    "gen:coordinator-bridge": "node scripts/generate-coordinator-bridge.mjs",
    "test": "node --test tests/*.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
