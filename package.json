{
  "name": "grokgrok",
  "version": "0.1.0",
  "private": true,
  "description": "Clean-room reconstruction and architecture atlas for Grok Bot 0.24+",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ingest": "node scripts/ingest.mjs",
    "inventory": "node scripts/ingest.mjs --inventory-only",
    "validate": "node scripts/validate-all.mjs",
    "gen:labels": "node scripts/generate-labels.mjs",
    "gen:desktop-bridge": "node scripts/generate-desktop-bridge.mjs",
    "gen:coordinator-bridge": "node scripts/generate-coordinator-bridge.mjs",
    "test": "node --test tests/*.mjs",
    "typecheck": "tsc --noEmit",
    "build:desktop": "tsc -p apps/desktop/tsconfig.json && cp apps/desktop/index.html apps/desktop/styles.css apps/desktop/dist/"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^5.9.3"
  }
}